# Vista Platform Core, Docker Compose: the variables compose.yaml reads.
#
# Do not copy this file to .env as it is: every secret below is empty on
# purpose, and compose refuses to start until each is set. Generate them:
#
#   umask 077
#   for v in POSTGRES_PASSWORD REDIS_PASSWORD NATS_PASSWORD JWT_SECRET INTERNAL_AUTH_SECRET ENCRYPTION_MASTER_KEY; do
#     echo "$v=$(openssl rand -hex 32)"; done > .env
#
# Keep .env: ENCRYPTION_MASTER_KEY encrypts the device and integration
# credentials you store, and a new one makes them unreadable. Keep it in your
# backups.

# Secrets (required)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NATS_PASSWORD=
JWT_SECRET=
INTERNAL_AUTH_SECRET=
ENCRYPTION_MASTER_KEY=

# Optional
# Address the published ports bind to. 127.0.0.1 keeps the install on this
# host; it serves plain HTTP, so put a TLS proxy in front before widening it.
#VISTA_BIND_ADDRESS=127.0.0.1
#WEB_UI_HOST_PORT=3000
#ADMIN_UI_HOST_PORT=3006
#API_GATEWAY_HOST_PORT=8080
#SENSOR_MANAGER_AGENT_HOST_PORT=8444
#DEVICE_INTERROGATION_AGENT_HOST_PORT=8446
# Outbound mail (sign-up verification, notifications). Unset, no mail is sent
# and new accounts need no verification.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#FROM_EMAIL=
