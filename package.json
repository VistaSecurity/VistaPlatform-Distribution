{
  "name": "vistaplatform-distribution-checks",
  "private": true,
  "description": "Checkers for the Distribution repository's collateral; not a published package.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "markdownlint-cli2 && node scripts/check-collateral.mjs && node scripts/check-workflows.mjs",
    "test": "node --test 'scripts/**/*.test.mjs'"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "markdownlint-cli2": "0.24.0"
  },
  "overrides": {
    "re2js": "2.8.7",
    "katex": "0.18.2"
  }
}
